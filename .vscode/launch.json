{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: EngineNet TUI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build RemakeEngine solution",

            "program": "${workspaceFolder}/EngineNet/.build/EngineNet/bin/Debug/net10.0/win-x64/EngineNet.exe",
            "args": ["--tui"],
            "cwd": "${workspaceFolder}/EngineNet",

            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "C#: EngineNet CLI, Run Demo lua script",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build RemakeEngine solution",

            "program": "${workspaceFolder}/EngineNet/.build/EngineNet/bin/Debug/net10.0/win-x64/EngineNet.dll",
            "args": ["--game_module", "demo", "--run_op", "1"],
            "cwd": "${workspaceFolder}/EngineNet",

            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}