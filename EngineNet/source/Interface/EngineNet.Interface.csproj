<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Default TFMs for CI and most dev machines (no Apple workloads required) -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="GUI\**" />
        <Compile Remove="Terminal\**" />
        <EmbeddedResource Remove="GUI\**" />
        <EmbeddedResource Remove="Terminal\**" />
        <None Remove="GUI\**" />
        <None Remove="Terminal\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\EngineNet.Core.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>


</Project>
