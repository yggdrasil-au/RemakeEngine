<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Default TFMs for CI and most dev machines (no Apple workloads required) -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\EngineNet.Core.csproj" />
        <ProjectReference Include="..\..\Interface\GUI\EngineNet.GUI.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- tui -->
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
        <PackageReference Include="Terminal.Gui" Version="2.4.17" />
        <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7" />
    </ItemGroup>

</Project>
