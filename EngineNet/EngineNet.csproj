<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Default TFMs for CI and most dev machines (no Apple workloads required) -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType> <!-- moved from WinExe to Exe to fix the countless TUI issues, will need to manually fix the terminal popup in GUI mode -->
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnableDefaultItems>false</EnableDefaultItems>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <StartupObject>EngineNet.Program</StartupObject>
        <ApplicationIcon>icon.ico</ApplicationIcon>

        <!-- Publish with all .net dependencies included (no .NET runtime required on target machine) -->
        <SelfContained>true</SelfContained>

        <!-- Publish as a single executable file -->
        <PublishSingleFile>true</PublishSingleFile>
        <!-- Include native libraries in the single file bundle -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <!-- Embedd PDBs in exe, these are used for debugging in published app -->
        <DebugType>embedded</DebugType>
        <Platforms>AnyCPU;x64</Platforms>

    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>EngineNet</AssemblyName>
        <Company>YggdrasilAu</Company>
        <Product>Remake-Engine</Product>
        <Copyright>Copyright © 2026 YggdrasilAu</Copyright>
        <Description>Remake Engine is a cross-platform automation tool for executing game remake modules</Description>
    </PropertyGroup>

    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Init.cs" />
        <Compile Include="Program.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="source\Core\EngineNet.Core.csproj" />
        <ProjectReference Include="source\GameFormats\EngineNet.GameFormats.csproj" />

        <ProjectReference Include="source\ScriptEngines\EngineNet.ScriptEngines.csproj" />
        <ProjectReference Include="source\Shared\EngineNet.Shared.csproj" />

        <!-- interfaces -->
        <ProjectReference Include="source\Interface\EngineNet.Interface.csproj" />
        <ProjectReference Include="source\Interface\Terminal\EngineNet.Interface.Terminal.csproj" />
        <ProjectReference Include="source\Interface\GUI\EngineNet.Interface.GUI.csproj" />

    </ItemGroup>

    <ItemGroup>
        <Content Include="icon.ico" />
    </ItemGroup>

</Project>
